{
  "info": {
    "name": "Fropti Video-to-Recipe",
    "description": "Видео-рецепт через STT + OCR + LLM. /health всегда 200; /extract и /extract/upload возвращают Recipe 1.0.0 или структурированную ошибку по API reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "video_url",
      "value": "https://www.youtube.com/shorts/REPLACE_WITH_VIDEO_ID"
    }
  ],
  "item": [
    {
      "name": "Health — 200",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Extract by URL — 200 с реальным видео и LLM-ключами, иначе 400/422/502/503",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"url\": \"{{video_url}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/extract"
      }
    },
    {
      "name": "Upload video — выбери локальный MP4 (≤100 МиБ, ≤180 с)",
      "request": {
        "method": "POST",
        "description": "В Body выбери локальное видео в поле file. Файл должен быть непустым и не больше 100 МиБ. Без ML-моделей вернётся 503 model_unavailable.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{base_url}}/extract/upload"
      }
    },
    {
      "name": "Invalid URL — 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"url\": \"not-a-url\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/extract"
      }
    }
  ]
}
