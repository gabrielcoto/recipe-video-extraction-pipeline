LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Язык рецепта на выходе LLM: auto — язык исходного видео. en or ru.
OUTPUT_LANGUAGE=auto

# --- Ограничения входа (раньше были жёстко заданы в коде) ---
# Максимальная длительность видео в секундах.
MAX_VIDEO_SECONDS=180
# Максимальный размер загружаемого файла в байтах:
# 104857600 = 100 * 1024 * 1024 = 100 MiB (в коде осталось исходное
# выражение 100 * 1024 * 1024). В .env арифметика не вычисляется,
# поэтому значение — готовое число.
MAX_UPLOAD_BYTES=104857600

# --- Нарезка кадров ---
# Не больше этого числа кадров на всё видео (равномерно по длительности).
# Больше кадров — выше шанс поймать короткие надписи (например, список
# ингредиентов на 5 секунд), но дольше OCR: время растёт линейно. 12 or 24, try.
MAX_FRAMES=12
# Ширина кадра после масштабирования, высота — пропорционально.
FRAME_WIDTH=1280

# --- STT (faster-whisper) ---
# small ~460 МБ; medium ~1.5 ГБ
# В full-образ запечён только small (WHISPER_PRELOAD_MODELS="small" в
# docker-compose.full.yml). Переключение на medium без пересборки: первый
# запрос разово докачает модель (~1.5 ГБ) в том hf-cache, где она переживёт
# и docker compose down. Запечь medium в образ: WHISPER_PRELOAD_MODELS:
# "small medium" в compose-файле
WHISPER_MODEL=small
# Язык речи: код языка (ru, en, ...) ускоряет и уточняет расшифровку.
# WHISPER_LANGUAGE=auto — автодетект faster-whisper (для мультиязычных
# видео). Это язык ВХОДНОГО аудио; язык ОТВЕТА задаёт OUTPUT_LANGUAGE ниже.
WHISPER_LANGUAGE=ru
# cpu | cuda (cuda требует GPU-сборок зависимостей, по умолчанию всё на CPU)
WHISPER_DEVICE=cpu
# Точность вычислений: int8 — быстрый вариант для CPU; float16 имеет смысл
# только на GPU; float32 — эталон, но медленнее и дороже по памяти.
WHISPER_COMPUTE_TYPE=int8

OCR_LANG=ru
# MKLDNN выключен явно для каждого предсказателя: Paddle 3.x включает oneDNN
# по умолчанию, а PaddleOCR 2.x при enable_mkldnn=False его не выключает — на
# части CPU и в эмуляции (Rosetta, QEMU, некоторые ВМ) OCR падает с «could not
# create a primitive descriptor for a reorder primitive». Включить MKLDNN:
# OCR_ENABLE_MKLDNN=1.
OCR_ENABLE_MKLDNN=0
OCR_MAX_CPU_ISA=AVX2
# Минимальная уверенность PaddleOCR для строки, 0..1. Строки ниже порога
# отбрасываются до дедупликации. 0 — порог выключен (поведение по умолчанию);
# при шумном распознавании попробуйте 0.5-0.6.
OCR_MIN_CONFIDENCE=0

DOWNLOAD_TIMEOUT_SECONDS=30
# JS-рантайм для yt-dlp (извлечение по URL). YouTube исполняет player-скрипты
# в JavaScript; yt-dlp (2026.10+) принимает node >= 22, deno >= 2.3 или
# bun >= 1.2.11 — более старые версии считаются неподдержанными, и /extract
# падает с download_failed («No supported JavaScript runtime could be found»).
# В Docker-образе стоит Node 22 из NodeSource (см. Dockerfile), поэтому
# значение по умолчанию — node. Альтернатива без внешнего apt-репозитория:
# pip install "yt-dlp[deno]" и YTDLP_JS_RUNTIME=deno. Пустое значение
# отключает передачу --js-runtimes (не рекомендуется для YouTube).
YTDLP_JS_RUNTIME=node
# Cookies для YouTube в формате Netscape («cookies.txt»): YouTube на части IP
# и видео требует авторизацию («Sign in to confirm you're not a bot»), без
# cookies извлечение по URL падает с download_failed. Экспорт — расширением
# «Get cookies.txt LOCALLY». Файл равнозначен доступу к аккаунту YouTube:
# держите его вне репозитория и не коммитьте; в Docker смонтируйте внутрь
# контейнера (закомментированный пример в compose-файлах) и укажите путь
# внутри контейнера.
# смонтирован только для чтения и роняет запуск с PermissionError.
# Пусто = флаг не передаётся.
# YTDLP_COOKIES_FILE=/cookies.txt
# Клиент плеера YouTube для yt-dlp (--extractor-args
# "youtube:player_client=…"): смена клиента иногда снимает «No title found
# Пусто = стандартный выбор yt-dlp.
# Произвольные extractor-args yt-dlp, разделитель «;» — обходной путь для
# меняющихся требований YouTube без правки кода (PO-токен, клиент плеера):
# YTDLP_EXTRACTOR_ARGS=youtube:po_token=mweb.gvs+XXX;youtube:player_client=tv
# PO-токен генерируется защитой YouTube в браузере; его получают плагины
# вроде bgutil-ytdlp-pot-provider — проект обходные механизмы не встраивает.
# Пусто = ничего не передаётся.
# YTDLP_EXTRACTOR_ARGS=
# Лимит скачивания по URL в байтах: 104857600 = 100 * 1024 * 1024 (100 MiB);
# по умолчанию равен MAX_UPLOAD_BYTES.
MAX_DOWNLOAD_BYTES=104857600
ALLOWED_URL_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,music.youtube.com
FFMPEG_TIMEOUT_SECONDS=120

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
# Повторы ТРАНЗИТОРНЫХ сетевых сбоев вызова LLM (обрыв соединения, таймаут,
# HTTP 408/429/502/503/504 от провайдера или шлюза). Это НЕ то же, что
# LLM_MAX_RETRIES выше: тот повторяет ответ при невалидном JSON/нарушении
# схемы Recipe. Постоянные ошибки (401/403/400) не повторяются. 0 — сетевой
# сбой падает сразу (502 llm_unavailable).
LLM_NETWORK_RETRIES=1
# Пауза между сетевыми повторами, секунды: моментальный повтор после 502/429
# почти всегда попадает в тот же сбой.
LLM_RETRY_DELAY_SECONDS=2
# Температура генерации: 0.0 — самый детерминированный ответ, лучше для
# извлечения данных. Раньше была жёстко задана в коде запроса.
LLM_TEMPERATURE=0.0
